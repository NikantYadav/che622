LAMMPS (22 Jul 2025 - Update 1)
# Step 10: NPT production run at 313.15 K, 0 bar for 20 ns

units real
atom_style full
boundary p p p

pair_style lj/class2/coul/long 12.0
bond_style class2
angle_style class2
dihedral_style class2
improper_style class2
kspace_style pppm 1e-4
pair_modify mix sixthpower

read_restart step10_restart_12000000.bin
