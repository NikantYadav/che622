# Step 8: NPT equilibration at 313.15 K, 100 bar for 1 ns

units real
atom_style full
boundary p p p

pair_style lj/class2/coul/long 12.0
bond_style class2
angle_style class2
dihedral_style class2
improper_style class2
kspace_style pppm 1e-4
pair_modify mix sixthpower

read_data step07_final.data

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

timestep 0.5

variable density equal density

fix data_output all ave/time 1000 1 1000 c_thermo_temp c_thermo_press v_density &
    file step08_TPD_data.dat

thermo_style custom step temp press vol density etotal ke pe
thermo 2000
thermo_modify flush yes

# ---------- Trajectory output ----------
dump traj all atom 10000 step08_trajectory.dump
dump_modify traj sort id

# Write restart files every 200,000 steps (~100 ps)
restart 50000 step08_restart_*.bin

fix npt8 all npt temp 313.15 313.15 100.0 aniso 98.6923 98.6923 1000.0 pchain 3

run 500000

unfix npt8
unfix data_output
undump traj

write_data step08_final.data

