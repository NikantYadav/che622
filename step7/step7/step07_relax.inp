# Step 7: NPT cooling from 500K to 313.15K at 100 bar for 2 ns

units real
atom_style full
boundary p p p

pair_style lj/class2/coul/long 12.0
bond_style class2
angle_style class2
dihedral_style class2
improper_style class2
kspace_style pppm 1e-4
pair_modify mix sixthpower

read_data step06_final.data

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

timestep 0.5

variable density equal density

fix data_output all ave/time 1000 1 1000 c_thermo_temp c_thermo_press v_density &
    file step07_TPD_data.dat

thermo_style custom step temp press vol density etotal ke pe
thermo 2000
thermo_modify flush yes

# ---------- Trajectory output ----------
dump traj all atom 10000 step06_trajectory.dump
dump_modify traj sort id

# Write restart files every 200,000 steps (~100 ps)
restart 50000 step01_restart_*.bin

# Critical cooling step to simulation temperature
fix npt7 all npt temp 500.0 313.15 100.0 aniso 98.6923 98.6923 1000.0 pchain 3

run 1000000  # 0.5 ns

unfix npt7
unfix data_output
undump traj

write_data step07_final.data
