  special bonds CPU = 0.003 seconds
  read_data CPU = 0.297 seconds

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# ---------- Time step ----------
timestep 0.5  # 0.5 fs

# ---------- Thermodynamics ----------
thermo_style custom step temp press vol density etotal ke pe
thermo 5000
thermo_modify flush yes

# ---------- Trajectory output ----------
dump traj all atom 10000 step01_trajectory.dump
dump_modify traj sort id

# ---------- Periodic backups ----------
# Write restart files every 200,000 steps (~100 ps)
restart 50000 step01_restart_*.bin

# ---------- Run control ----------
fix nvt1 all nvt temp 1000.0 1000.0 100.0 tchain 3

run 200000
