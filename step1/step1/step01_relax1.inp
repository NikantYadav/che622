# Initialization ----------
units real
atom_style full
boundary p p p

pair_style lj/class2/coul/long 12.0
bond_style class2
angle_style class2
dihedral_style class2
improper_style class2
kspace_style pppm 1e-4

pair_modify mix sixthpower

read_data coal_pcff.data

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# ---------- Time step ----------
timestep 0.5  # 0.5 fs

# ---------- Thermodynamics ----------
thermo_style custom step temp press vol density etotal ke pe
thermo 5000
thermo_modify flush yes

# ---------- Trajectory output ----------
dump traj all atom 10000 step01_trajectory.dump
dump_modify traj sort id

# ---------- Periodic backups ----------
# Write restart files every 200,000 steps (~100 ps)
restart 50000 step01_restart_*.bin

# ---------- Run control ----------
fix nvt1 all nvt temp 1000.0 1000.0 100.0 tchain 3

run 200000

#---------- Cleanup ----------
unfix nvt1
undump traj

# Final write
write_data step01_final.data

