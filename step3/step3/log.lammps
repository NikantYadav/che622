LAMMPS (22 Jul 2025 - Update 1)
# Step 3: NPT cooling from 1000K to 700K at 100 bar for 5 ns

units real
atom_style full
boundary p p p

# PCFF Force Field
pair_style lj/class2/coul/long 12.0
bond_style class2
angle_style class2
dihedral_style class2
improper_style class2
kspace_style pppm 1e-4
pair_modify mix sixthpower

read_data step02_final.data
