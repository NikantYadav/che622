neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

timestep 0.5

thermo_style custom step temp press vol density etotal
thermo 5000
thermo_modify flush yes

# ---------- Trajectory output ----------
dump traj all atom 10000 step01_trajectory.dump
dump_modify traj sort id

# Write restart files every 200,000 steps (~100 ps)
restart 50000 step01_restart_*.bin

# NPT with linear temperature ramp
fix npt3 all npt temp 1000.0 700.0 200.0 aniso 98.6923 98.6923 1000.0 pchain 3

# Run for 5 ns (10,000,000 steps)
run 2500000
