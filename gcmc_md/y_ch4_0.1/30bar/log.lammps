variable V0 equal vol
print "Initial system volume (V0): ${V0}"
Initial system volume (V0): 39537.1320650039

unfix nvt_coal

# --- STAGE 2: GCMC/MD SIMULATION ---
print "Starting Hybrid GCMC/MD Simulation..."
Starting Hybrid GCMC/MD Simulation...

# Rigid body dynamics for CO2 molecules
fix rigid_co2 co2 rigid/nvt/small molecule temp ${temp} ${temp} ${Tdamp} mol co2_mol
fix rigid_co2 co2 rigid/nvt/small molecule temp 313.15 ${temp} ${Tdamp} mol co2_mol
fix rigid_co2 co2 rigid/nvt/small molecule temp 313.15 313.15 ${Tdamp} mol co2_mol
fix rigid_co2 co2 rigid/nvt/small molecule temp 313.15 313.15 100 mol co2_mol
Fix rigid/nvt/small setup ...
  create bodies CPU = 0.001 seconds
  0 rigid bodies with 0 atoms
  1.16 = max distance from body owner to body atom
fix_modify rigid_co2 dynamic/dof yes

# NPT for entire system
fix npt_coal coal npt temp ${temp} ${temp} ${Tdamp} aniso ${press} ${press} ${Pdamp}
fix npt_coal coal npt temp 313.15 ${temp} ${Tdamp} aniso ${press} ${press} ${Pdamp}
fix npt_coal coal npt temp 313.15 313.15 ${Tdamp} aniso ${press} ${press} ${Pdamp}
fix npt_coal coal npt temp 313.15 313.15 100 aniso ${press} ${press} ${Pdamp}
fix npt_coal coal npt temp 313.15 313.15 100 aniso 29.61 ${press} ${Pdamp}
fix npt_coal coal npt temp 313.15 313.15 100 aniso 29.61 29.61 ${Pdamp}
fix npt_coal coal npt temp 313.15 313.15 100 aniso 29.61 29.61 1000

# GCMC for CH4 (no rigid constraint needed)
fix gcmc_ch4 ch4 gcmc 2000 500 0 0 54321 ${temp} 0.0 0.0 mol ch4_mol pressure ${press} fugacity_coeff ${phi_ch4} group ch4 tfac_insert 1.0 full_energy overlap_cutoff 1
fix gcmc_ch4 ch4 gcmc 2000 500 0 0 54321 313.15 0.0 0.0 mol ch4_mol pressure ${press} fugacity_coeff ${phi_ch4} group ch4 tfac_insert 1.0 full_energy overlap_cutoff 1
fix gcmc_ch4 ch4 gcmc 2000 500 0 0 54321 313.15 0.0 0.0 mol ch4_mol pressure 29.61 fugacity_coeff ${phi_ch4} group ch4 tfac_insert 1.0 full_energy overlap_cutoff 1
fix gcmc_ch4 ch4 gcmc 2000 500 0 0 54321 313.15 0.0 0.0 mol ch4_mol pressure 29.61 fugacity_coeff 0.98226 group ch4 tfac_insert 1.0 full_energy overlap_cutoff 1

# GCMC for CO2 (with rigid constraint)
fix gcmc_co2 co2 gcmc 2000 500 0 0 12345 ${temp} 0.0 0.0 mol co2_mol pressure ${press} fugacity_coeff ${phi_co2} group co2 rigid rigid_co2 tfac_insert 1.0 full_energy overlap_cutoff 1
fix gcmc_co2 co2 gcmc 2000 500 0 0 12345 313.15 0.0 0.0 mol co2_mol pressure ${press} fugacity_coeff ${phi_co2} group co2 rigid rigid_co2 tfac_insert 1.0 full_energy overlap_cutoff 1
fix gcmc_co2 co2 gcmc 2000 500 0 0 12345 313.15 0.0 0.0 mol co2_mol pressure 29.61 fugacity_coeff ${phi_co2} group co2 rigid rigid_co2 tfac_insert 1.0 full_energy overlap_cutoff 1
fix gcmc_co2 co2 gcmc 2000 500 0 0 12345 313.15 0.0 0.0 mol co2_mol pressure 29.61 fugacity_coeff 0.86475 group co2 rigid rigid_co2 tfac_insert 1.0 full_energy overlap_cutoff 1

# Modify thermo compute for dynamic DOF
compute_modify thermo_temp dynamic/dof yes

# ========== ISOSTERIC HEAT OF ADSORPTION SETUP ==========

# Compute potential energy for each gas species
compute pe_ch4 ch4 pe/atom
compute pe_co2 co2 pe/atom

# Sum total PE for each species
compute total_pe_ch4 ch4 reduce sum c_pe_ch4
compute total_pe_co2 co2 reduce sum c_pe_co2

# Variables for analysis
variable strain equal (vol - v_V0) / v_V0

variable nCH4_atoms equal count(ch4_atoms)
variable nCO2_C equal count(co2_C_atoms)
variable nCO2_O equal count(co2_O_atoms)


# Calculate number of molecules
variable n_ch4 equal v_nCH4_atoms        # CH4 is 1 atom per molecule
variable n_co2 equal (v_nCO2_C+v_nCO2_O)/3.0   # CO2 is 3 atoms per molecule

# Selectivity (with safety for division by zero)
variable n_ch4_safe equal "v_n_ch4 + 0.001"
variable selectivity equal v_n_co2/v_n_ch4_safe


# Variables for Qst calculation (fluctuation method)
variable U_ch4 equal c_total_pe_ch4
variable U_co2 equal c_total_pe_co2

# Reference the molecule counts (not redefining, just aliasing for clarity)
variable Nmol_ch4 equal v_n_ch4
variable Nmol_co2 equal v_n_co2

# Products needed for fluctuation formula
variable UN_ch4 equal v_U_ch4*v_Nmol_ch4
variable UN_co2 equal v_U_co2*v_Nmol_co2
variable N2_ch4 equal v_Nmol_ch4*v_Nmol_ch4
variable N2_co2 equal v_Nmol_co2*v_Nmol_co2

# GCMC acceptance ratios
variable iacc_ch4 equal f_gcmc_ch4[4]/(f_gcmc_ch4[3]+0.1)
variable dacc_ch4 equal f_gcmc_ch4[6]/(f_gcmc_ch4[5]+0.1)
variable iacc_co2 equal f_gcmc_co2[4]/(f_gcmc_co2[3]+0.1)
variable dacc_co2 equal f_gcmc_co2[6]/(f_gcmc_co2[5]+0.1)

thermo_style custom step temp press vol v_strain density atoms c_TempCO2 v_n_ch4 v_n_co2 v_iacc_ch4 v_dacc_ch4 v_iacc_co2 v_dacc_co2 pe ke
thermo 10000

dump 1 all custom 50000 dump.gcmc.lammpstrj id type x y z
dump visual_ch4 ch4 custom 5000 ch4_molecules.lammpstrj id type mol x y z
dump visual_co2 co2 custom 5000 co2_molecules.lammpstrj id type mol x y z

# Equilibration run
run 200000
