variable V0 equal vol
print "Initial system volume (V0): ${V0}"
Initial system volume (V0): 39537.1320650039

unfix nvt_coal

# --- STAGE 2: GCMC/MD SIMULATION ---
print "Starting Hybrid GCMC/MD Simulation..."
Starting Hybrid GCMC/MD Simulation...

# Rigid body dynamics for CO2 molecules
fix rigid_co2 co2 rigid/nvt/small molecule temp ${temp} ${temp} ${Tdamp} mol co2_mol
fix rigid_co2 co2 rigid/nvt/small molecule temp 313.15 ${temp} ${Tdamp} mol co2_mol
fix rigid_co2 co2 rigid/nvt/small molecule temp 313.15 313.15 ${Tdamp} mol co2_mol
fix rigid_co2 co2 rigid/nvt/small molecule temp 313.15 313.15 100 mol co2_mol
Fix rigid/nvt/small setup ...
  create bodies CPU = 0.000 seconds
  0 rigid bodies with 0 atoms
  1.16 = max distance from body owner to body atom
fix_modify rigid_co2 dynamic/dof yes

# NPT for entire system
fix npt_all all npt temp ${temp} ${temp} ${Tdamp} aniso ${press} ${press} ${Pdamp}
fix npt_all all npt temp 313.15 ${temp} ${Tdamp} aniso ${press} ${press} ${Pdamp}
fix npt_all all npt temp 313.15 313.15 ${Tdamp} aniso ${press} ${press} ${Pdamp}
fix npt_all all npt temp 313.15 313.15 100 aniso ${press} ${press} ${Pdamp}
fix npt_all all npt temp 313.15 313.15 100 aniso 0.49 ${press} ${Pdamp}
fix npt_all all npt temp 313.15 313.15 100 aniso 0.49 0.49 ${Pdamp}
fix npt_all all npt temp 313.15 313.15 100 aniso 0.49 0.49 1000

# GCMC for CH4 (no rigid constraint needed)
fix gcmc_ch4 ch4 gcmc 1000 1000 0 0 54321 ${temp} 0.0 0.0 mol ch4_mol pressure ${press} fugacity_coeff ${phi_ch4} group ch4 tfac_insert 1.0 full_energy
fix gcmc_ch4 ch4 gcmc 1000 1000 0 0 54321 313.15 0.0 0.0 mol ch4_mol pressure ${press} fugacity_coeff ${phi_ch4} group ch4 tfac_insert 1.0 full_energy
fix gcmc_ch4 ch4 gcmc 1000 1000 0 0 54321 313.15 0.0 0.0 mol ch4_mol pressure 0.49 fugacity_coeff ${phi_ch4} group ch4 tfac_insert 1.0 full_energy
fix gcmc_ch4 ch4 gcmc 1000 1000 0 0 54321 313.15 0.0 0.0 mol ch4_mol pressure 0.49 fugacity_coeff 0.99956 group ch4 tfac_insert 1.0 full_energy

# GCMC for CO2 (with rigid constraint)
fix gcmc_co2 co2 gcmc 1000 1000 0 0 12345 ${temp} 0.0 0.0 mol co2_mol pressure ${press} fugacity_coeff ${phi_co2} group co2 rigid rigid_co2 tfac_insert 1.0 full_energy
fix gcmc_co2 co2 gcmc 1000 1000 0 0 12345 313.15 0.0 0.0 mol co2_mol pressure ${press} fugacity_coeff ${phi_co2} group co2 rigid rigid_co2 tfac_insert 1.0 full_energy
fix gcmc_co2 co2 gcmc 1000 1000 0 0 12345 313.15 0.0 0.0 mol co2_mol pressure 0.49 fugacity_coeff ${phi_co2} group co2 rigid rigid_co2 tfac_insert 1.0 full_energy
fix gcmc_co2 co2 gcmc 1000 1000 0 0 12345 313.15 0.0 0.0 mol co2_mol pressure 0.49 fugacity_coeff 0.99766 group co2 rigid rigid_co2 tfac_insert 1.0 full_energy

# Modify thermo compute for dynamic DOF
compute_modify thermo_temp dynamic/dof yes

# Variables for analysis
variable n_ch4 equal count(ch4_count)
variable n_co2 equal count(co2_count)
variable n_ch4_safe equal "v_n_ch4 * (v_n_ch4 > 0) + 1 * (v_n_ch4 == 0)"
variable selectivity equal v_n_co2/v_n_ch4_safe
variable strain equal (vol - v_V0) / v_V0

# GCMC acceptance ratios
variable iacc_ch4 equal f_gcmc_ch4[4]/(f_gcmc_ch4[3]+0.1)
variable dacc_ch4 equal f_gcmc_ch4[6]/(f_gcmc_ch4[5]+0.1)
variable iacc_co2 equal f_gcmc_co2[4]/(f_gcmc_co2[3]+0.1)
variable dacc_co2 equal f_gcmc_co2[6]/(f_gcmc_co2[5]+0.1)

thermo_style custom step temp press vol v_strain density atoms c_TempCO2 v_n_ch4 v_n_co2 v_iacc_ch4 v_dacc_ch4 v_iacc_co2 v_dacc_co2 pe ke
thermo 10000

dump 1 all custom 50000 dump.gcmc.lammpstrj id type x y z

# Equilibration run
run 250000
