# Define molecule templates with type offsets
# Assuming coal uses types 1-20, bonds 1-34, angles 1-72
molecule ch4_mol molecule_ch4.dat toff 20
Read molecule template ch4_mol:
# CH4 molecule template (TraPPE united atom)
  1 molecules
  0 fragments
  0 bodies
  1 atoms with max type 21
  0 bonds with max type 0
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0
molecule co2_mol molecule_co2.dat toff 20 boff 34 aoff 72
Read molecule template co2_mol:
# CO2 molecule template (TraPPE)
  1 molecules
  0 fragments
  0 bodies
  3 atoms with max type 22
  2 bonds with max type 35
  1 angles with max type 73
  0 dihedrals with max type 0
  0 impropers with max type 0

# Mass definitions (types 21, 22, 23 after offset)
mass 21 16.04     # CH4
mass 22 12.01     # C in CO2
mass 23 15.999    # O in CO2

# Pair coefficients
pair_coeff 21 21 0.294106 3.73
pair_coeff 22 22 0.053655 2.80
pair_coeff 23 23 0.156989 3.05
pair_coeff 21 22 0.125619 3.2650
pair_coeff 21 23 0.214875 3.3900
pair_coeff 22 23 0.091778 2.9250

# Bond and angle coefficients (types 35 and 73 after offset)
bond_coeff 35 1.16 1250.0 0.0 0.0
angle_coeff 73 180.0 160.0 0.0 0.0
angle_coeff 73 bb 0.0 1.16 1.16
angle_coeff 73 ba 0.0 0.0 1.16 1.16

# Groups
group coal type 1:20
3640 atoms in group coal
group ch4 type 21
0 atoms in group ch4
group co2 type 22:23
0 atoms in group co2

# Define atom-style variables
variable is_ch4 atom "type==21"
variable is_co2_C atom "type==22"     # CO2 carbon
variable is_co2_O atom "type==23"     # CO2 oxygen

# Create dynamic groups (use gases as parent, not "all")
group ch4_atoms dynamic ch4 var is_ch4
dynamic group ch4_atoms defined
group co2_C_atoms dynamic co2 var is_co2_C
dynamic group co2_C_atoms defined
group co2_O_atoms dynamic co2 var is_co2_O
dynamic group co2_O_atoms defined

neighbor 3.0 bin
neigh_modify delay 0 every 1 check yes
timestep 1.0

variable temp equal 313.15
variable press equal 148.04
variable phi_ch4 equal 1.30891
variable phi_co2 equal 0.4333
variable Tdamp equal 100.0
variable Pdamp equal 1000.0

# Compute for CO2 temperature
compute TempCO2 co2 temp
compute_modify TempCO2 dynamic/dof yes

# Minimize energy
minimize 1.0e-4 1.0e-6 10000 100000
