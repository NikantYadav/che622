
# Atom type definitions:
# Type 1 = CH4   (methane united atom)
# Type 2 = C_CO2 (carbon in CO2)
# Type 3 = O_CO2 (oxygen in CO2)

# Pure component interactions
pair_coeff 1 1 0.294106 3.73   # CH4-CH4 [1]
pair_coeff 2 2 0.053655 2.80   # C_CO2-C_CO2 [2]
pair_coeff 3 3 0.156989 3.05   # O_CO2-O_CO2 [2]

# Cross interactions (Lorentz-Berthelot mixing rules)
# epsilon_ij = sqrt(epsilon_i * epsilon_j)
# sigma_ij = (sigma_i + sigma_j) / 2
pair_coeff 1 2 0.125619 3.2650  # CH4-C_CO2
pair_coeff 1 3 0.214875 3.3900  # CH4-O_CO2
pair_coeff 2 3 0.091778 2.9250  # C_CO2-O_CO2

# Format: bond_coeff bond_type K(kcal/mol/Angstrom^2) r0(Angstrom)


bond_coeff 1 1000.0 1.16  # C_CO2-O_CO2 bond [2]

# =================================================
# ANGLE PARAMETERS (CO2 only)
# =================================================
# Format: angle_coeff angle_type K(kcal/mol/rad^2) theta0(degrees)


angle_coeff 1 1000.0 180.0  # O_CO2-C_CO2-O_CO2 angle [2]

