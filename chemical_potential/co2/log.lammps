LAMMPS (22 Jul 2025 - Update 1)
# Pure CH4 bulk system setup
units real
dimension 3
boundary p p p
atom_style atomic

# Create simulation box (adjust size as needed)
region box block 0 50 0 50 0 50
create_box 1 box
Created orthogonal box = (0 0 0) to (50 50 50)
  2 by 4 by 5 MPI processor grid

# Define CH4 mass and interactions using TraPPE-UA model
mass 1 16.04  # CH4 molecular weight

# TraPPE-UA Lennard-Jones parameters for CH4
pair_style lj/cut 14.0
pair_coeff 1 1 0.294106 3.73   # CH4-CH4  # epsilon (kcal/mol), sigma (Angstrom)

# Use Lorentz-Berthelot mixing rules
pair_modify mix arithmetic tail yes

# Temperature and chemical potential settings
variable T equal 313.15  # Temperature in K
variable mu equal -8.0  # Chemical potential (kcal/mol)

# Timestep and thermostat
timestep 1.0  # fs
fix thermostat all nvt temp ${T} ${T} 100.0
fix thermostat all nvt temp 313.15 ${T} 100.0
fix thermostat all nvt temp 313.15 313.15 100.0

# GCMC fix - insertion/deletion of CH4 molecules
fix gcmc all gcmc 1000 1000 100 1 49284 ${T} ${mu} 1.0
fix gcmc all gcmc 1000 1000 100 1 49284 313.15 ${mu} 1.0
fix gcmc all gcmc 1000 1000 100 1 49284 313.15 -8 1.0

# Output thermodynamic properties
thermo_style custom step temp press vol atoms density
thermo 100

compute_modify thermo_temp dynamic/dof yes

dump 1 all atom 1000 ch4_gcmc_mu-8.0.lammpstrj

# Run hybrid GCMC/MD simulation
run 50000  # 50 ps equilibration
Generated 0 of 0 mixed pair_coeff terms from arithmetic mixing rule
