# bulk CH4 GCMC

units           real
atom_style      full
boundary        p p p

# --- System Definition ---
region          simbox block 0.0 50.0 0.0 50.0 0.0 50.0 units box
create_box      3 simbox bond/types 1 angle/types 1 # Create a box for one atom type (CH4)

# --- Force Field ---
pair_style      lj/cut 14.0
bond_style      harmonic
angle_style     harmonic
include         trappe_params.dat

# --- Molecule Definition ---
molecule        ch4_mol molecule_ch4.dat
mass            1 16.04 # Mass of TraPPE CH4
mass            2 12.01    # C in CO2
mass            3 15.999   # O in CO2

# --- GCMC Settings ---
variable        mu equal -7.00 # <-- SET CHEMICAL POTENTIAL HERE (kcal/mol)
variable        temp equal 313.15

variable natoms equal atoms
variable density equal density
variable vol equal vol

# --- Temperature Control Setup ---
# Create compute for temperature that adjusts for changing atom count
compute         mdtemp all temp
compute_modify  mdtemp dynamic yes

# NVT thermostat for proper temperature control
fix             nvt_control all nvt temp ${temp} ${temp} 100.0
fix_modify      nvt_control temp mdtemp

# Remove center-of-mass motion periodically
fix             momentum_fix all momentum 100 linear 1 1 1

# Modify thermo_temp to be dynamic for proper temperature output
compute_modify  thermo_temp dynamic yes


#       fix ID  group  gcmc  N  X  M type seed Temp   mu    disp  keyword ...
fix             gcmc_run all gcmc 100 5000 5000 0 54321 ${temp} ${mu} 0.5 mol ch4_mol

fix data_output all ave/time 500 1 500 c_thermo_temp c_thermo_press v_natoms c_thermo_pe v_density v_vol &
    file ch4_gcmc_data.dat

# --- Simulation Run ---
timestep        1.0
thermo_style    custom step temp press density vol atoms
thermo          1000

# Optional: Dump trajectory for visualization
# dump          1 all atom 1000 ch4_gcmc.lammpstrj

# Run for equilibration and then production
run             50000 # 50 ps equilibration

run             100000 # 100 ps production run for averaging

unfix data_output
