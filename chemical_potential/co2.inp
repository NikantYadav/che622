# bulk CO2 GCMC

# --- Initialization ---
units           real
atom_style      full
boundary        p p p

# --- System Definition ---
region          simbox block 0.0 50.0 0.0 50.0 0.0 50.0 units box
create_box      3 simbox bond/types 1 angle/types 1 # Box for 3 atom types (CH4, C_CO2, O_CO2)

# --- Force Field ---
pair_style      lj/cut/coul/long 14.0
pair_modify     mix arithmetic # Let LAMMPS calculate cross-interactions
bond_style      harmonic
angle_style     harmonic
kspace_style    ewald 1e-4
include         trappe_params.dat

# --- Molecule Definition ---
molecule        co2_mol molecule_co2.dat
mass            1 16.04    # CH4
mass            2 12.01    # Mass of C in CO2
mass            3 15.999   # Mass of O in CO2

# --- GCMC Settings ---
variable        mu equal -13.0 # <-- SET CHEMICAL POTENTIAL HERE (kcal/mol)
variable        temp equal 313.15

group           co2_gas type 2 3
#       fix ID   group    gcmc  N   X     M    type seed Temp   mu    disp  keyword ...
fix             gcmc_run all gcmc 100 5000 5000 0 12345 ${temp} ${mu} 0.5 mol co2_mol

# Explanation: 'type' is 2 because the base atom for molecule insertion is the Carbon atom (type 2).

# --- Simulation Run ---
timestep        1.0
thermo_style    custom step temp press pe ke density vol atoms
thermo          1000

# Use fix shake to keep CO2 rigid, as intended by the TraPPE model
# This constrains bond type 1 and angle type 1 defined in molecule_co2.dat
fix             rigid_co2 all shake 0.0001 20 0 b 1 a 1

# Optional: Dump trajectory for visualization
# dump          1 all atom 1000 co2_gcmc.lammpstrj

# Run for equilibration and then production
run             50000 # 50 ps equilibration
reset_timestep  0
run             100000 # 100 ps production run for averaging

# --- Output ---
variable        P_avg equal press
variable        N_avg equal "atoms"

print "CO2 Result -> mu: ${mu} kcal/mol | Avg Pressure: ${P_avg} atm | Avg Atoms: ${N_avg}" append co2_results_summary.txt
