  special bonds CPU = 0.003 seconds
  read_data CPU = 0.403 seconds

# ============ DEFINE MASSES ============
# Add CH4 mass for type 21 (coal masses 1-20 are already in data file)
mass            21 16.04    # CH4 molecular weight (TraPPE-UA)

# ============ ADDITIONAL PAIR COEFFICIENTS ============
# Your PCFF parameters (types 1-20) are loaded from data file
# Only need to add TraPPE-UA parameters for CH4 (type 21)
pair_coeff      21 21 0.294106 3.73   # CH4-CH4: epsilon (kcal/mol), sigma (Angstrom)

# Cross-interactions between CH4 (type 21) and coal atoms (types 1-20)
# will be calculated automatically via geometric mixing rule

# ============ NEIGHBOR SETTINGS ============
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ============ GROUPS ============
group           coal type 1:20      # Your coal atoms
3640 atoms in group coal
group           methane type 21     # CH4 atoms (to be inserted via GCMC)
0 atoms in group methane

# ============ SYSTEM PROPERTIES ============
variable        vol equal vol
variable        temp equal 298.15
variable        lx equal lx
variable        ly equal ly
variable        lz equal lz

print           "System volume: ${vol} A^3"
System volume: 39649.0770159341 A^3
print           "Box dimensions: ${lx} x ${ly} x ${lz} A"
Box dimensions: 35.1780299881456 x 38.2666953673279 x 29.4537507992592 A
print           "Coal atoms: $(count(coal))"
Coal atoms: 3640

# ============ INITIAL SETUP ============
reset_timestep  0

# ============ MINIMIZATION ============
minimize        1.0e-6 1.0e-4 5000 50000
