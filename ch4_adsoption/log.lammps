# ============ DEFINE MASSES ============
mass            21 16.04    # CH4 molecular weight (TraPPE-UA)

# ============ ADDITIONAL PAIR COEFFICIENTS ============
pair_coeff      21 21 0.294106 3.73   # CH4-CH4: TraPPE-UA parameters

# ============ NEIGHBOR SETTINGS ============
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ============ GROUPS ============
group           coal type 1:20
3640 atoms in group coal
group           methane type 21
0 atoms in group methane

# ============ SYSTEM PROPERTIES ============
variable        vol equal vol
variable        temp equal 298.15
variable        pressure equal 30.25
variable        mu equal 8.7330

print           "System volume: ${vol} A^3"
System volume: 39537.1320650039 A^3
print           "Coal atoms: $(count(coal))"
Coal atoms: 3640
print           "Pressure: ${pressure} bar"
Pressure: 30.25 bar
print           "Chemical potential: ${mu} kcal/mol"
Chemical potential: 8.733 kcal/mol

# ============ INITIAL SETUP ============
reset_timestep  0

# ============ MINIMIZATION ============
minimize        1.0e-6 1.0e-4 5000 50000
