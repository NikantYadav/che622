LAMMPS (22 Jul 2025 - Update 1)
# =============================================================================
# LAMMPS Script for CH4 Adsorption Isotherm in Coal
# FULLY CORRECTED - All force field styles defined before read_data
# Coal: PCFF force field (your 20 atom types) + CH4: TraPPE-UA (type 21)
# =============================================================================

# ============ INITIALIZATION ============
units           real
atom_style      full
boundary        p p p

# ============ DEFINE ALL FORCE FIELD STYLES FIRST ============
# CRITICAL: Must define ALL styles BEFORE read_data when data file contains coefficients
# Your data file contains: Pair Coeffs, Bond Coeffs, Angle Coeffs, Dihedral Coeffs, Improper Coeffs

# Pair interactions
pair_style      lj/class2/coul/long 14.0
pair_modify     mix geometric tail yes

# Bonded interactions (PCFF class2)
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2

# Long-range interactions
kspace_style    pppm 1.0e-5

# ============ READ DATA WITH EXTRA ATOM TYPE ============
# Now we can safely read data file since all styles are defined
read_data       coal_structure.data extra/atom/types 1
Reading data file ...
  orthogonal box = (-18.498525 -24.247052 -9.040546) to (16.679505 14.019644 20.413205)
  4 by 5 by 2 MPI processor grid
  reading atoms ...
  3640 atoms
  reading velocities ...
  3640 velocities
  scanning bonds ...
  4 = max bonds/atom
  scanning angles ...
  6 = max angles/atom
  scanning dihedrals ...
  21 = max dihedrals/atom
  scanning impropers ...
  4 = max impropers/atom
  orthogonal box = (-18.498525 -24.247052 -9.040546) to (16.679505 14.019644 20.413205)
  4 by 5 by 2 MPI processor grid
  reading bonds ...
  4020 bonds
  reading angles ...
  7100 angles
  reading dihedrals ...
  11170 dihedrals
  reading impropers ...
  3110 impropers
