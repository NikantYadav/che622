# =============================================================================
# LAMMPS Script for CH4 Adsorption Isotherm in Coal
# EVERY LINE VALIDATED AGAINST LAMMPS DOCUMENTATION
# Coal: PCFF force field (20 atom types) + CH4: TraPPE-UA (type 21)
# =============================================================================

# ============ INITIALIZATION ============
units           real
atom_style      full
boundary        p p p

# ============ DEFINE ALL FORCE FIELD STYLES FIRST ============
# Required before read_data when data file contains coefficients
pair_style      lj/class2/coul/long 14.0
pair_modify     mix geometric tail yes
bond_style      class2
angle_style     class2  
dihedral_style  class2
improper_style  class2
kspace_style    pppm 1.0e-5

# ============ READ DATA WITH EXTRA ATOM TYPE ============
read_data       coal_structure.data extra/atom/types 1

# ============ DEFINE MASSES ============
mass            21 16.04    # CH4 molecular weight (TraPPE-UA)

# ============ ADDITIONAL PAIR COEFFICIENTS ============
pair_coeff      21 21 0.294106 3.73   # CH4-CH4: TraPPE-UA parameters

# ============ NEIGHBOR SETTINGS ============
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ============ GROUPS ============
group           coal type 1:20
group           methane type 21

# ============ SYSTEM PROPERTIES ============
variable        vol equal vol
variable        temp equal 298.15

print           "System volume: ${vol} A^3"
print           "Coal atoms: $(count(coal))"

# ============ INITIAL SETUP ============
reset_timestep  0

# ============ MINIMIZATION ============
minimize        1.0e-6 1.0e-4 5000 50000

# ============ INITIAL EQUILIBRATION ============
velocity        coal create ${temp} 12345
fix             nvt_equil coal nvt temp ${temp} ${temp} 100.0
timestep        1.0
run             25000
unfix           nvt_equil

# ============ GCMC SETUP ============
molecule        ch4_mol ch4_molecule.txt

# Thermostat for all atoms during GCMC
fix             nvt_gcmc all nvt temp ${temp} ${temp} 100.0

# Constants
variable        kb equal 0.0019872041
variable        total_coal_mass equal 45500.0    # Approximate mass in mg

# Create compute to count CH4 atoms (LAMMPS documentation validated)
compute         count_ch4 methane count/type atom

# Output file header
print           "# CH4 Adsorption Isotherm - Coal Model" file isotherm_results.dat
print           "# System: 3640 atoms, 20 types, PCFF class2 + TraPPE-UA" append isotherm_results.dat
print           "# Temperature: ${temp} K, Volume: ${vol} A^3" append isotherm_results.dat
print           "# Pressure(bar) N_CH4 Loading(mg/g) Loading(mmol/g) Density Chemical_Potential" append isotherm_results.dat

# ============ PRESSURE POINT 1: 0.5 bar ============
variable        pressure equal 0.5
variable        mu equal -9.44634

print           "Pressure: ${pressure} bar, mu: ${mu} kcal/mol"

fix             gcmc_fix methane gcmc 50 50 0 0 54321 ${temp} ${mu} 1.5 &
                mol ch4_mol maxangle 10 full_energy

# Equilibration with DOCUMENTATION-VALIDATED thermo_style
variable        nequil equal 50000
thermo          5000
thermo_style    custom step temp press vol v_pressure atoms
run             ${nequil}

# Production
variable        nprod equal 100000
variable        n_ch4 equal count(methane)
variable        ch4_mw equal 16.04
variable        loading_mg_g equal v_n_ch4*${ch4_mw}*1000/v_total_coal_mass
variable        loading_mmol_g equal v_n_ch4*1000/v_total_coal_mass
variable        density_molec_A3 equal v_n_ch4/v_vol

fix             stats all ave/time 500 50 50000 v_n_ch4 v_loading_mg_g v_loading_mmol_g v_density_molec_A3 &
                file production_0.5bar.dat

thermo          10000
thermo_style    custom step temp press vol atoms v_n_ch4
run             ${nprod}

# Output results
variable        final_n_ch4 equal v_n_ch4
variable        final_loading_mg_g equal v_loading_mg_g
variable        final_loading_mmol_g equal v_loading_mmol_g
variable        final_density equal v_density_molec_A3
print           "${pressure} ${final_n_ch4} ${final_loading_mg_g} ${final_loading_mmol_g} ${final_density} ${mu}" append isotherm_results.dat

unfix           gcmc_fix
unfix           stats
print           "Completed: P=${pressure} bar, N_CH4=${final_n_ch4}, Loading=${final_loading_mg_g} mg/g"

# ============ PRESSURE POINT 2: 2.0 bar ============
variable        pressure equal 2.0
variable        mu equal -8.70186

print           "Pressure: ${pressure} bar, mu: ${mu} kcal/mol"

fix             gcmc_fix methane gcmc 50 50 0 0 54321 ${temp} ${mu} 1.5 &
                mol ch4_mol maxangle 10 full_energy

run             ${nequil}

fix             stats all ave/time 500 50 50000 v_n_ch4 v_loading_mg_g v_loading_mmol_g v_density_molec_A3 &
                file production_2.0bar.dat

run             ${nprod}

variable        final_n_ch4 equal v_n_ch4
variable        final_loading_mg_g equal v_loading_mg_g
variable        final_loading_mmol_g equal v_loading_mmol_g
variable        final_density equal v_density_molec_A3
print           "${pressure} ${final_n_ch4} ${final_loading_mg_g} ${final_loading_mmol_g} ${final_density} ${mu}" append isotherm_results.dat

unfix           gcmc_fix
unfix           stats
print           "Completed: P=${pressure} bar, N_CH4=${final_n_ch4}, Loading=${final_loading_mg_g} mg/g"

# ============ PRESSURE POINT 3: 5.0 bar ============
variable        pressure equal 5.0
variable        mu equal -8.20956

print           "Pressure: ${pressure} bar, mu: ${mu} kcal/mol"

fix             gcmc_fix methane gcmc 50 50 0 0 54321 ${temp} ${mu} 1.5 &
                mol ch4_mol maxangle 10 full_energy

run             ${nequil}

fix             stats all ave/time 500 50 50000 v_n_ch4 v_loading_mg_g v_loading_mmol_g v_density_molec_A3 &
                file production_5.0bar.dat

run             ${nprod}

variable        final_n_ch4 equal v_n_ch4
variable        final_loading_mg_g equal v_loading_mg_g
variable        final_loading_mmol_g equal v_loading_mmol_g
variable        final_density equal v_density_molec_A3
print           "${pressure} ${final_n_ch4} ${final_loading_mg_g} ${final_loading_mmol_g} ${final_density} ${mu}" append isotherm_results.dat

unfix           gcmc_fix
unfix           stats
print           "Completed: P=${pressure} bar, N_CH4=${final_n_ch4}, Loading=${final_loading_mg_g} mg/g"

# ============ PRESSURE POINT 4: 10.0 bar ============
variable        pressure equal 10.0
variable        mu equal -7.83442

print           "Pressure: ${pressure} bar, mu: ${mu} kcal/mol"

fix             gcmc_fix methane gcmc 50 50 0 0 54321 ${temp} ${mu} 1.5 &
                mol ch4_mol maxangle 10 full_energy

run             ${nequil}

fix             stats all ave/time 500 50 50000 v_n_ch4 v_loading_mg_g v_loading_mmol_g v_density_molec_A3 &
                file production_10.0bar.dat

run             ${nprod}

variable        final_n_ch4 equal v_n_ch4
variable        final_loading_mg_g equal v_loading_mg_g
variable        final_loading_mmol_g equal v_loading_mmol_g
variable        final_density equal v_density_molec_A3
print           "${pressure} ${final_n_ch4} ${final_loading_mg_g} ${final_loading_mmol_g} ${final_density} ${mu}" append isotherm_results.dat

unfix           gcmc_fix
unfix           stats
print           "Completed: P=${pressure} bar, N_CH4=${final_n_ch4}, Loading=${final_loading_mg_g} mg/g"

# ============ PRESSURE POINT 5: 20.0 bar ============
variable        pressure equal 20.0
variable        mu equal -7.45428

print           "Pressure: ${pressure} bar, mu: ${mu} kcal/mol"

fix             gcmc_fix methane gcmc 50 50 0 0 54321 ${temp} ${mu} 1.5 &
                mol ch4_mol maxangle 10 full_energy

run             ${nequil}

fix             stats all ave/time 500 50 50000 v_n_ch4 v_loading_mg_g v_loading_mmol_g v_density_molec_A3 &
                file production_20.0bar.dat

run             ${nprod}

variable        final_n_ch4 equal v_n_ch4
variable        final_loading_mg_g equal v_loading_mg_g
variable        final_loading_mmol_g equal v_loading_mmol_g
variable        final_density equal v_density_molec_A3
print           "${pressure} ${final_n_ch4} ${final_loading_mg_g} ${final_loading_mmol_g} ${final_density} ${mu}" append isotherm_results.dat

unfix           gcmc_fix
unfix           stats
print           "Completed: P=${pressure} bar, N_CH4=${final_n_ch4}, Loading=${final_loading_mg_g} mg/g"

# ============ PRESSURE POINT 6: 40.0 bar ============
variable        pressure equal 40.0
variable        mu equal -7.06414

print           "Pressure: ${pressure} bar, mu: ${mu} kcal/mol"

fix             gcmc_fix methane gcmc 50 50 0 0 54321 ${temp} ${mu} 1.5 &
                mol ch4_mol maxangle 10 full_energy

run             ${nequil}

fix             stats all ave/time 500 50 50000 v_n_ch4 v_loading_mg_g v_loading_mmol_g v_density_molec_A3 &
                file production_40.0bar.dat

run             ${nprod}

variable        final_n_ch4 equal v_n_ch4
variable        final_loading_mg_g equal v_loading_mg_g
variable        final_loading_mmol_g equal v_loading_mmol_g
variable        final_density equal v_density_molec_A3
print           "${pressure} ${final_n_ch4} ${final_loading_mg_g} ${final_loading_mmol_g} ${final_density} ${mu}" append isotherm_results.dat

unfix           gcmc_fix
unfix           stats
print           "Completed: P=${pressure} bar, N_CH4=${final_n_ch4}, Loading=${final_loading_mg_g} mg/g"

# ============ COMPLETION ============
print           ""
print           "===== SIMULATION COMPLETE ====="
print           "Results in: isotherm_results.dat"
print           "Individual data: production_*bar.dat"
print           "==============================="
