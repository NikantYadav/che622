# ============ INITIAL EQUILIBRATION ============
velocity        coal create ${temp} 12345
velocity        coal create 298.15 12345
fix             nvt_equil coal nvt temp ${temp} ${temp} 100.0
fix             nvt_equil coal nvt temp 298.15 ${temp} 100.0
fix             nvt_equil coal nvt temp 298.15 298.15 100.0
timestep        1.0
run             25000
