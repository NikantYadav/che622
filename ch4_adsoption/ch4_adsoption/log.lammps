  special bond factors coul:  0        0        0       
     4 = max # of 1-2 neighbors
     9 = max # of 1-3 neighbors
    24 = max # of 1-4 neighbors
    27 = max # of special neighbors
  special bonds CPU = 0.003 seconds
  read_data CPU = 0.397 seconds

# ============ DEFINE MASSES ============
mass            21 16.04    # CH4 molecular weight (TraPPE-UA)

# ============ ADDITIONAL PAIR COEFFICIENTS ============
pair_coeff      21 21 0.294106 3.73   # CH4-CH4: TraPPE-UA parameters

# ============ NEIGHBOR SETTINGS ============
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# ============ GROUPS ============
group           coal type 1:20
3640 atoms in group coal
group           methane type 21
0 atoms in group methane

# ============ SYSTEM PROPERTIES ============
variable        vol equal vol
variable        temp equal 298.15

print           "System volume: ${vol} A^3"
System volume: 39649.0770159341 A^3
print           "Coal atoms: $(count(coal))"
Coal atoms: 3640

# ============ INITIAL SETUP ============
reset_timestep  0

# ============ MINIMIZATION ============
minimize        1.0e-6 1.0e-4 5000 50000
