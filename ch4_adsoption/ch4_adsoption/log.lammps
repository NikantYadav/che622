unfix           nvt_equil

# ============ GCMC SETUP ============
molecule        ch4_mol ch4_molecule.txt
Read molecule template ch4_mol:
# TraPPE-UA CH4 molecule template
  1 molecules
  0 fragments
  0 bodies
  1 atoms with max type 21
  0 bonds with max type 0
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0

# Thermostat for all atoms during GCMC
fix             nvt_gcmc all nvt temp ${temp} ${temp} 100.0
fix             nvt_gcmc all nvt temp 298.15 ${temp} 100.0
fix             nvt_gcmc all nvt temp 298.15 298.15 100.0

# Constants
variable        kb equal 0.0019872041
variable        total_coal_mass equal 45500.0    # Approximate mass in mg

# Create compute to count CH4 atoms (LAMMPS documentation validated)
compute         count_ch4 methane count/type atom

# Output file header
print           "# CH4 Adsorption Isotherm - Coal Model" file isotherm_results.dat
# CH4 Adsorption Isotherm - Coal Model
print           "# System: 3640 atoms, 20 types, PCFF class2 + TraPPE-UA" append isotherm_results.dat
# System: 3640 atoms, 20 types, PCFF class2 + TraPPE-UA
print           "# Temperature: ${temp} K, Volume: ${vol} A^3" append isotherm_results.dat
# Temperature: 298.15 K, Volume: 39649.0770159341 A^3
print           "# Pressure(bar) N_CH4 Loading(mg/g) Loading(mmol/g) Density Chemical_Potential" append isotherm_results.dat
# Pressure(bar) N_CH4 Loading(mg/g) Loading(mmol/g) Density Chemical_Potential

# ============ PRESSURE POINT 1: 0.5 bar ============
variable        pressure equal 0.5
variable        mu equal -9.44634

print           "Pressure: ${pressure} bar, mu: ${mu} kcal/mol"
Pressure: 0.5 bar, mu: -9.44634 kcal/mol

fix             gcmc_fix methane gcmc 50 50 0 0 54321 ${temp} ${mu} 1.5                 mol ch4_mol maxangle 10 full_energy
fix             gcmc_fix methane gcmc 50 50 0 0 54321 298.15 ${mu} 1.5                 mol ch4_mol maxangle 10 full_energy
fix             gcmc_fix methane gcmc 50 50 0 0 54321 298.15 -9.44634 1.5                 mol ch4_mol maxangle 10 full_energy

# Equilibration with DOCUMENTATION-VALIDATED thermo_style
variable        nequil equal 50000
thermo          5000
thermo_style    custom step temp press vol v_pressure atoms
run             ${nequil}
run             50000
